        async function renameNiche(id) {
            const newName = prompt("Enter new name for this niche:");
            if (newName) {
                const niche = DB.niches.find(n => n.id === id); const oldName = niche.name; niche.name = newName;
                // Update all clients with this niche
                DB.clients.forEach(c => { if (c.business_niche === oldName) c.business_niche = newName; });
                await saveDB(); renderApp();
            }
        }

        async function mergeNiche(id) {
            const targetName = prompt("Enter the name of the niche you want to merge this INTO:");
            if (targetName) {
                const targetNiche = DB.niches.find(n => n.name === targetName && !n.is_deleted);
                if (targetNiche && targetNiche.id !== id) {
                    const sourceNiche = DB.niches.find(n => n.id === id);
                    DB.clients.forEach(c => { if (c.business_niche === sourceNiche.name) c.business_niche = targetName; });
                    sourceNiche.is_deleted = true; sourceNiche.deleted_date = new Date().toISOString();
                    await saveDB(); renderApp();
                } else { showToast("Target niche not found or invalid", "error"); }
            }
        }

