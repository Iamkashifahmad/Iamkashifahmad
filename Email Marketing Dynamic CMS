                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4 mb-8">
                    ${kpis.map(k => `
                        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-5 shadow-soft hover:shadow-soft-lg transition-shadow">
                            <h3 class="text-xs font-medium text-slate-500 uppercase tracking-wider mb-2">${k.title}</h3>
