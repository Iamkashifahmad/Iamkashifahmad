            return `
                <div class="bg-gradient-to-r from-primary to-primary-dark text-white p-6 rounded-xl shadow-soft-lg mb-8 flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-bold mb-1">Daily Motivation</h3>
