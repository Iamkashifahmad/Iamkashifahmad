            let motivationMsg = "";
            if (!goalStatus.completed) {
                motivationMsg = `🔥 You're only ${goalStatus.remaining} emails away from today's goal!`;
            } else if (goalStatus.bonus > 0) {
                motivationMsg = `🚀 Outstanding work! You exceeded the goal by ${goalStatus.bonus} emails!`;
            } else {
                motivationMsg = "🎯 Goal achieved. Fantastic work today!";
