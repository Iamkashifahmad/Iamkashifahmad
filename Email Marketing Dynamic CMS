        function handleClientFormSubmit() {
            const id = document.getElementById('edit_id').value; const additionalEmails = [];
            document.querySelectorAll('#email-container input').forEach(input => { if (input.value.trim()) additionalEmails.push(input.value.trim()); });
            const clientData = {
                name: document.getElementById('name').value, business_name: document.getElementById('business_name').value,
                primary_email: document.getElementById('primary_email').value, additional_emails: additionalEmails,
                location: document.getElementById('location').value, website: document.getElementById('website').value,
                business_niche: document.getElementById('business_niche').value, tags: document.getElementById('tags').value.split(',').map(t => t.trim()).filter(Boolean)
            };
            const allEmails = [clientData.primary_email.toLowerCase(), ...additionalEmails.map(e => e.toLowerCase())];
            const duplicate = DB.clients.find(c => !c.is_deleted && c.id != id && (allEmails.includes(c.primary_email.toLowerCase()) || c.additional_emails?.some(e => allEmails.includes(e.toLowerCase()))));
            if (duplicate) {
                pendingClientData = { id, ...clientData }; pendingDuplicateId = duplicate.id;
                document.getElementById('duplicate-content').innerHTML = `<p><strong>Name:</strong> ${duplicate.name}</p><p><strong>Business:</strong> ${duplicate.business_name || '-'}</p><p><strong>Email:</strong> ${duplicate.primary_email}</p><p><strong>Date Added:</strong> ${new Date(duplicate.date_added).toLocaleDateString()}</p><p><strong>Status:</strong> ${duplicate.status}</p>`;
                openModal('duplicateModal');
            } else { saveClientData(id, clientData); }
        }

        function forceSaveClient() { closeModal('duplicateModal'); saveClientData(pendingClientData.id, pendingClientData); }
        function viewDuplicateClient() { closeModal('duplicateModal'); closeModal('clientModal'); openClientModal(pendingDuplicateId); }

        async function saveClientData(id, data) {
            if (id) {
                const index = DB.clients.findIndex(c => c.id == id); DB.clients[index] = { ...DB.clients[index], ...data };
                logActivity('Edited Client', `Updated info for ${data.name}`); showToast('Client updated successfully');
            } else {
                DB.clients.push({ id: Date.now(), ...data, status: 'LEAD', firstEmailDate: null, lastActivityDate: null, date_added: new Date().toISOString(), is_deleted: false, deleted_date: null, notes: [], attachments: [] });
                logActivity('Added Client', `Created new client ${data.name}`); showToast('Client added successfully');
            }
            if (data.business_niche && !DB.niches.some(n => n.name === data.business_niche)) {
                DB.niches.push({ id: 'niche_' + Date.now(), name: data.business_niche, is_deleted: false, deleted_date: null });
                logActivity('Niche Added', `Added new business niche: ${data.business_niche}`);
            }
            await saveDB(); closeModal('clientModal'); renderApp();
        }

