        }

        // ==========================================
        // 7. AUTOMATED WORKFLOWS
        // ==========================================
        async function processWorkflowAutomations() {
            let followupsDue = 0; let dbChanged = false;
            DB.clients.forEach(c => {
                if (!c.is_deleted && c.firstEmailDate) {
                    let daysSinceFirst = getDaysPassed(c.firstEmailDate); let daysSinceLast = getDaysPassed(c.lastActivityDate);
                    if (daysSinceFirst >= 90 && c.status !== 'RESPONDED' && c.status !== 'NO_RESPONSE' && c.status !== 'CLOSED') {
                        c.status = 'NO_RESPONSE'; dbChanged = true; logActivity('Status Auto-Updated', `${c.name} moved to No Response (90 days)`);
                    }
                    if (c.status === 'SENT' && daysSinceLast >= 7) followupsDue++;
                }
            });
            if (dbChanged) await saveDB();
            const badge = document.getElementById('followups-badge');
            if (followupsDue > 0) { badge.innerText = followupsDue; badge.classList.remove('hidden'); } else { badge.classList.add('hidden'); }
        }

