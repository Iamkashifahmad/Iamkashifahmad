            const client = DB.clients.find(c => c.id === id);
            client.status = 'SENT'; client.firstEmailDate = new Date().toISOString(); client.lastActivityDate = new Date().toISOString();
            DB.activities.push({ id: Date.now(), client_id: id, type: 'COLD_EMAIL', date: new Date().toISOString() });
            logActivity('Sent Email', `Cold email logged for ${client.name}`); await saveDB(); showToast('Cold email logged successfully'); renderApp();
        }

        async function sendFollowUp(id) {
            const client = DB.clients.find(c => c.id === id); const count = DB.activities.filter(a => a.client_id === id && a.type === 'FOLLOWUP').length;
            client.status = 'FOLLOWUP_SENT'; client.lastActivityDate = new Date().toISOString();
            DB.activities.push({ id: Date.now(), client_id: id, type: 'FOLLOWUP', followup_number: count + 1, date: new Date().toISOString() });
