<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dot | ColdMail CRM Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="https://media.licdn.com/dms/image/v2/D4D0BAQGReoFapfSZ2g/company-logo_100_100/company-logo_100_100/0/1683707555895?e=1786579200&v=beta&t=cBLuoJPUpC4_iEZe5Z8fEkkoy8eZlgfURGcB2UMTHdk">
    <style id="dynamic-colors">
        /* Default colors, will be overwritten by JS */
        :root {
            --color-primary: #FF5F1F;
            --color-primary-dark: #e54f15;
            --color-primary-light: #ff7b45;
            --color-sidebar: #0f172a;
        }
        .bg-primary { background-color: var(--color-primary); }
        .hover\:bg-primary-dark:hover { background-color: var(--color-primary-dark); }
        .text-primary { color: var(--color-primary); }
        .border-primary { border-color: var(--color-primary); }
        .ring-primary { --tw-ring-color: var(--color-primary); }
        .bg-sidebar-custom { background-color: var(--color-sidebar); }
    </style>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            boxShadow: {
              'soft': '0 2px 8px 0 rgba(0,0,0,0.05), 0 1px 2px 0 rgba(0,0,0,0.03)',
              'soft-lg': '0 4px 16px 0 rgba(0,0,0,0.08)'
            }
          }
        }
      }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .modal-open { display: flex !important; }
        .toast-in { animation: toastIn 0.3s ease-out forwards; }
        @keyframes toastIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
        .fade-in { animation: fadeIn 0.2s ease-out forwards; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .dark ::-webkit-scrollbar-thumb { background: #475569; }
        .dark ::-webkit-scrollbar-thumb:hover { background: #64748b; }
        html { scroll-behavior: smooth; }
        th { user-select: none; }
        .circular-chart { display: block; margin: 10px auto; max-width: 80%; max-height: 120px; }
        .circle-bg { fill: none; stroke: #eee; stroke-width: 3.8; }
        .dark .circle-bg { stroke: #334155; }
        .circle { fill: none; stroke-width: 2.8; stroke-linecap: round; animation: progress 1s ease-out forwards; }
        @keyframes progress { from { stroke-dashoffset: 1000; } }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-gray-200 flex h-screen overflow-hidden transition-colors duration-300">

    <!-- DB Setup Modal -->
    <div id="dbSetupModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-[200] p-4">
        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-8 w-full max-w-md shadow-2xl text-center">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path></svg>
            </div>
            <h2 class="text-xl font-bold mb-2 text-slate-900 dark:text-white">Connect Database</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">Locate your existing database to load your data, or create a new one to start fresh.</p>
            <div class="flex flex-col gap-3">
                <button onclick="linkDatabase()" class="bg-primary hover:bg-primary-dark text-white px-4 py-2.5 rounded-lg text-sm font-medium transition-colors">Locate Existing Database</button>
                <button onclick="createDatabase()" class="bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-white px-4 py-2.5 rounded-lg text-sm font-medium transition-colors">Create New Database</button>
            </div>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-4">Requires Chrome or Edge. Never overwrite an existing database.</p>
        </div>
    </div>

    <!-- App Layout -->
    <div class="w-full flex">
        <!-- Sidebar -->
        <aside class="w-64 bg-white dark:bg-slate-950 border-r border-slate-200 dark:border-slate-800 flex flex-col flex-shrink-0 transition-colors duration-300">
            <div class="h-16 flex items-center px-6 border-b border-slate-200 dark:border-slate-800">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-md flex items-center justify-center font-bold text-white"><img src="https://media.licdn.com/dms/image/v2/D4D0BAQGReoFapfSZ2g/company-logo_100_100/company-logo_100_100/0/1683707555895?e=1786579200&v=beta&t=cBLuoJPUpC4_iEZe5Z8fEkkoy8eZlgfURGcB2UMTHdk" alt="DOT" style="border-radius: 50%;"></div>
                    <span class="text-lg font-bold text-slate-900 dark:text-white tracking-tight">DOT - Mail CRM</span>
                </div>
            </div>
            <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
                <button onclick="switchView('dashboard')" id="nav-dashboard" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors bg-primary text-white shadow-soft">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg> Dashboard
                </button>
                <button onclick="switchView('clients')" id="nav-clients" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors w-full">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg> All Clients
                </button>
                <button onclick="switchView('sent')" id="nav-sent" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors w-full">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg> Sent Emails
                </button>
                <button onclick="switchView('followups')" id="nav-followups" class="nav-btn flex items-center justify-between gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors w-full">
                    <div class="flex items-center gap-3"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> Weekly Follow-ups</div>
                    <span id="followups-badge" class="bg-primary text-white text-xs px-2 py-0.5 rounded-full font-bold hidden">0</span>
                </button>
                <button onclick="switchView('responded')" id="nav-responded" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors w-full">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg> Client Responded
                </button>
                <button onclick="switchView('noresponse')" id="nav-noresponse" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors w-full">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg> No Response
                </button>
                
                <div class="pt-4 mt-4 border-t border-slate-200 dark:border-slate-800">
                    <button onclick="toggleNicheList()" class="flex items-center justify-between w-full px-3 py-2 text-xs uppercase tracking-wider text-slate-400 font-semibold">
                        <span>Business Niches</span>
                        <svg id="niche-toggle-icon" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>
                    <div id="niche-list-sidebar" class="hidden space-y-1 mt-1 max-h-48 overflow-y-auto"></div>
                </div>

                <div class="pt-4 mt-4 border-t border-slate-200 dark:border-slate-800">
                    <p class="px-3 mb-2 text-xs uppercase tracking-wider text-slate-400 dark:text-slate-600 font-semibold">Management</p>
                    <button onclick="switchView('niches')" id="nav-niches" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors w-full">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg> Manage Niches
                    </button>
                    <button onclick="switchView('trash')" id="nav-trash" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors w-full">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg> Trash
                    </button>
                    <button onclick="switchView('activity')" id="nav-activity" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors w-full">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg> Activity Log
                    </button>
                    <button onclick="switchView('settings')" id="nav-settings" class="nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors w-full">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg> Settings
                    </button>
                </div>
            </nav>
            
            <!-- Daily Goal Tracker Widget -->
            <div class="p-4 border-t border-slate-200 dark:border-slate-800">
                <div id="goal-tracker-widget" class="bg-slate-50 dark:bg-slate-900 rounded-lg p-3"></div>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="flex flex-col flex-1 overflow-hidden">
            <header class="h-16 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-8 bg-white dark:bg-slate-950/50 backdrop-blur-sm flex-shrink-0 transition-colors duration-300">
                <h1 id="page-title" class="text-xl font-bold text-slate-900 dark:text-white capitalize">Dashboard</h1>
                
                <div class="flex items-center gap-4">
                    <div class="relative">
                        <input type="text" id="global-search" placeholder="Search clients, emails..." onkeyup="globalSearch(this.value)" class="w-64 pl-9 pr-4 py-2 bg-slate-100 dark:bg-slate-800 rounded-lg text-sm outline-none focus:ring-2 focus:ring-primary transition-all text-slate-700 dark:text-white">
                        <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        <div id="search-results" class="absolute top-12 right-0 w-96 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg shadow-soft-lg hidden max-h-96 overflow-y-auto z-50"></div>
                    </div>

                    <button onclick="toggleTheme()" class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                        <svg id="theme-icon-sun" class="w-5 h-5 text-slate-600 dark:text-slate-300 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                        <svg id="theme-icon-moon" class="w-5 h-5 text-slate-600 dark:text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                    </button>

                    <button id="add-client-btn" onclick="openClientModal()" class="hidden items-center gap-2 bg-primary hover:bg-primary-dark text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-soft">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg> Add Client
                    </button>
                </div>
            </header>

            <main class="flex-1 overflow-y-auto p-8 bg-slate-50 dark:bg-slate-900 transition-colors duration-300">
                <div id="view-container" class="fade-in"></div>
            </main>
        </div>
    </div>

    <!-- Modals -->
    <div id="clientModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-8 w-full max-w-2xl max-h-[90vh] overflow-y-auto shadow-soft-lg">
            <h2 id="modal-title" class="text-xl font-bold mb-6 text-slate-900 dark:text-white">Add New Client</h2>
            <form id="clientForm" class="space-y-5" onsubmit="event.preventDefault(); handleClientFormSubmit();">
                <input type="hidden" id="edit_id">
                <div class="grid grid-cols-2 gap-5">
                    <div>
                        <label class="block text-xs font-medium mb-1.5 text-slate-500 uppercase tracking-wider">Client Name *</label>
                        <input type="text" name="name" id="name" required class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-slate-900 dark:text-white text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium mb-1.5 text-slate-500 uppercase tracking-wider">Business Name</label>
                        <input type="text" name="business_name" id="business_name" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-slate-900 dark:text-white text-sm">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium mb-1.5 text-slate-500 uppercase tracking-wider">Primary Email *</label>
                    <input type="email" name="primary_email" id="primary_email" required class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-slate-900 dark:text-white text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium mb-1.5 text-slate-500 uppercase tracking-wider">Additional Emails</label>
                    <div id="email-container" class="space-y-2"></div>
                    <button type="button" onclick="addEmailField()" class="text-primary text-xs font-medium mt-2 hover:text-primary-dark flex items-center gap-1">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg> Add another email
                    </button>
                </div>
                <div class="grid grid-cols-2 gap-5">
                    <div>
                        <label class="block text-xs font-medium mb-1.5 text-slate-500 uppercase tracking-wider">Location</label>
                        <input type="text" name="location" id="location" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-slate-900 dark:text-white text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium mb-1.5 text-slate-500 uppercase tracking-wider">Website</label>
                        <input type="text" name="website" id="website" placeholder="example.com" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-slate-900 dark:text-white text-sm">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium mb-1.5 text-slate-500 uppercase tracking-wider">Business Niche</label>
                    <input type="text" name="business_niche" id="business_niche" list="niche-list" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-slate-900 dark:text-white text-sm">
                    <datalist id="niche-list"></datalist>
                </div>
                <div>
                    <label class="block text-xs font-medium mb-1.5 text-slate-500 uppercase tracking-wider">Tags</label>
                    <input type="text" name="tags" id="tags" placeholder="Hot Lead, VIP" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-slate-900 dark:text-white text-sm">
                </div>
                <div class="flex justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-700 mt-6">
                    <button type="button" onclick="closeModal('clientModal')" class="px-4 py-2 text-sm font-medium text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors">Cancel</button>
                    <button type="submit" class="bg-primary px-5 py-2 rounded-lg text-sm font-medium hover:bg-primary-dark text-white transition-colors shadow-soft">Save Client</button>
                </div>
            </form>
        </div>
    </div>

    <div id="duplicateModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-[60] p-4">
        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-8 w-full max-w-md shadow-soft-lg">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-yellow-100 dark:bg-yellow-900/30 rounded-full flex items-center justify-center">
