            a.href = url; a.download = `crm-backup-${new Date().toISOString().split('T')[0]}.json`; a.click(); URL.revokeObjectURL(url); showToast("Backup downloaded!");
        }

        async function restoreBackup(event) {
            const file = event.target.files[0]; if (!file) return;
            if (confirm("Restoring will OVERWRITE all current data. Are you sure?")) {
                const text = await file.text(); DB = JSON.parse(text); migrateDB(); await saveDB(); showToast("Backup restored successfully!"); applyThemeAndColors(); renderApp();
            }
            event.target.value = '';
        }

        // ==========================================
        // IMPORT DATABASE (Merge feature)
        // ==========================================
        // Merges clients from an external JSON file into the current database.
        // - Does NOT overwrite existing data
        // - Prevents duplicate entries (checked by email)
        // - Automatically saves everything back into crm-database.json
        async function importDatabase(event) {
            const file = event.target.files[0];
            if (!file) return;

            try {
                const text = await file.text();
                const importedData = JSON.parse(text);

                // Determine the clients array from various possible formats
                let importedClients = [];
                let importedNiches = [];

                if (Array.isArray(importedData)) {
                    // Format 1: Simple array of client objects
                    importedClients = importedData;
                } else if (importedData.clients && Array.isArray(importedData.clients)) {
                    // Format 2: Full database format (e.g., backup file, another crm-database.json)
                    importedClients = importedData.clients;
                    importedNiches = importedData.niches || [];
                } else if (importedData.name || importedData.primary_email || importedData.email) {
                    // Format 3: Single client object
                    importedClients = [importedData];
                } else {
                    showToast("Unrecognized file format. Expected JSON with clients array or single client object.", "error");
                    event.target.value = '';
                    return;
                }

                // Build a set of existing emails for duplicate detection
                const existingEmails = new Set();
                DB.clients.forEach(c => {
                    if (c.primary_email) existingEmails.add(c.primary_email.toLowerCase().trim());
                    if (c.additional_emails) {
                        c.additional_emails.forEach(e => {
                            if (typeof e === 'string') existingEmails.add(e.toLowerCase().trim());
                        });
                    }
                });

                // Track existing IDs to avoid conflicts
                const existingIds = new Set(DB.clients.map(c => c.id));

                let addedCount = 0;
                let skippedCount = 0;
                const baseId = Date.now();

                importedClients.forEach(c => {
                    // Skip invalid entries
                    if (!c || (!c.primary_email && !c.email && !c.name)) {
                        skippedCount++;
                        return;
                    }

                    const primaryEmail = (c.primary_email || c.email || '').toLowerCase().trim();
                    const additionalEmails = (c.additional_emails || [])
                        .map(e => typeof e === 'string' ? e.toLowerCase().trim() : '')
                        .filter(Boolean);
                    const allEmails = [primaryEmail, ...additionalEmails].filter(Boolean);

                    // Check for duplicates by email
                    const isDuplicate = allEmails.length > 0 && allEmails.some(e => existingEmails.has(e));

                    if (isDuplicate) {
                        skippedCount++;
                    } else {
                        // Add new emails to the existing set
                        allEmails.forEach(e => existingEmails.add(e));

                        // Generate a unique ID that doesn't conflict with existing IDs
                        let newId = c.id || (baseId + addedCount);
                        while (existingIds.has(newId)) {
                            newId = baseId + addedCount + Math.floor(Math.random() * 100000);
                        }
                        existingIds.add(newId);

                        // Create the migrated client object
                        const newClient = {
                            id: newId,
                            name: c.name || 'Unknown',
                            business_name: c.business_name || c.businessName || '',
                            primary_email: c.primary_email || c.email || '',
                            additional_emails: c.additional_emails || [],
                            location: c.location || '',
                            website: c.website || '',
                            business_niche: c.business_niche || c.businessNiche || c.categories || '',
                            tags: c.tags || [],
                            notes: c.notes || [],
                            attachments: c.attachments || [],
                            status: c.status || 'LEAD',
                            firstEmailDate: c.firstEmailDate || null,
                            lastActivityDate: c.lastActivityDate || null,
                            date_added: c.date_added || new Date().toISOString(),
                            is_deleted: false,
                            deleted_date: null
                        };

                        DB.clients.push(newClient);
                        addedCount++;

                        // Auto-create niche if it doesn't exist
                        if (newClient.business_niche && !DB.niches.some(n => n.name === newClient.business_niche)) {
                            DB.niches.push({
                                id: 'niche_' + (baseId + addedCount + DB.niches.length),
                                name: newClient.business_niche,
                                is_deleted: false,
                                deleted_date: null
                            });
                        }
                    }
                });

                // Merge niches from imported data (if full database format)
                importedNiches.forEach(n => {
                    const nicheName = typeof n === 'string' ? n : (n.name || '');
                    if (nicheName && !DB.niches.some(existing => existing.name === nicheName)) {
                        DB.niches.push({
                            id: 'niche_' + (baseId + DB.niches.length + 1),
                            name: nicheName,
                            is_deleted: false,
                            deleted_date: null
                        });
                    }
                });

                // Save everything back to the database file
                await saveDB();

                logActivity('Database Imported', `Imported ${addedCount} clients, skipped ${skippedCount} duplicates from ${file.name}`);
                showToast(`Import complete: ${addedCount} added, ${skippedCount} duplicates skipped`);
                renderApp();

            } catch (err) {
                console.error("Import error:", err);
                showToast("Error importing file: " + (err.message || "Unknown error"), "error");
            }

            // Reset the file input so the same file can be selected again later
            event.target.value = '';
        }

        function initApp() {
            migrateDB();
            applyThemeAndColors();
            switchView('dashboard');
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') { document.querySelectorAll('.modal-open').forEach(m => m.classList.remove('modal-open')); document.getElementById('search-results').classList.add('hidden'); }
            if ((e.ctrlKey || e.metaKey) && e.key === 'n') { e.preventDefault(); if (currentView === 'clients') openClientModal(); }
            if ((e.ctrlKey || e.metaKey) && e.key === 'f') { e.preventDefault(); document.getElementById('global-search').focus(); }
        });

        window.addEventListener('beforeunload', async () => { if (fileHandle) { await saveDB(); } });
    </script>
</body>
