            DB.clients.filter(c => !c.is_deleted).forEach(c => {
                csv += `"${c.name}","${c.business_name || ''}","${c.primary_email}","${c.status}","${c.business_niche || ''}","${new Date(c.date_added).toLocaleDateString()}"\n`;
