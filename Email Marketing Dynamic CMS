    <div id="toast-container" class="fixed bottom-6 right-6 space-y-3 z-[100]"></div>

    <script>
        // ==========================================
        // 1. DATABASE & STATE MANAGEMENT
        // ==========================================
        let DB = { clients: [], activities: [], activity_log: [], niches: [], settings: {}, dailyGoals: [] };
        let currentView = 'dashboard';
        let currentNicheView = null;
        let fileHandle = null;
        let pendingClientData = null;
        let pendingDuplicateId = null;
        let filters = { search: '', niche: '', status: '', location: '' };
        let pagination = { page: 1, perPage: 25 };
        let tableState = { sortKey: 'date_added', sortDir: 'desc', hiddenCols: [] };
        let chartInstances = {}; // Store Chart.js instances to destroy before re-render

        // DB Migration (Preserves old data, adds new fields dynamically)
        function migrateDB() {
            if (!DB.activity_log) DB.activity_log = [];
            if (!DB.dailyGoals) DB.dailyGoals = [];
            
            // Settings Migration
            if (!DB.settings) DB.settings = {};
            DB.settings.companyName = DB.settings.companyName || 'ColdMail CRM';
            DB.settings.dashboardName = DB.settings.dashboardName || 'Dashboard';
            DB.settings.dailyGoal = DB.settings.dailyGoal || 20;
            DB.settings.preferences = DB.settings.preferences || { showCharts: true, compactMode: false, animations: true };
            DB.settings.colors = DB.settings.colors || { primary: '#FF5F1F', sidebar: '#0f172a' };

            // Niche Migration (String to Object for Trash support)
            if (DB.niches.length > 0 && typeof DB.niches[0] === 'string') {
                DB.niches = DB.niches.map(name => ({ id: 'niche_' + name.replace(/\s/g, '_'), name, is_deleted: false, deleted_date: null }));
            }

            // Client Migration
            DB.clients.forEach(c => {
                if (c.categories && !c.business_niche) c.business_niche = c.categories;
                if (!c.tags) c.tags = [];
                if (!c.notes) c.notes = [];
                if (!c.attachments) c.attachments = [];
                if (c.is_deleted === undefined) c.is_deleted = false;
                if (!c.deleted_date) c.deleted_date = null;
            });
        }

        // ==========================================
        // AUTO-CONNECT LOGIC (Fixed: persists across reloads)
        // ==========================================
        // On page load, automatically reconnect to the previously linked database
        // without asking the user again. Uses requestPermission() which auto-grants
        // in Chrome 86+ when permission was previously granted.

        async function autoConnect() {
            if (!window.showOpenFilePicker) {
                showDbSetupModal();
                return;
            }

            try {
                const handle = await getFileHandleFromIDB();
                if (!handle) {
                    // No saved handle — first time use or cleared storage
                    showDbSetupModal();
                    return;
                }

                fileHandle = handle;
                const opts = { mode: 'readwrite' };

                // Step 1: Check current permission state
                let permission;
                try {
                    permission = await fileHandle.queryPermission(opts);
                } catch (e) {
                    console.error('queryPermission error:', e);
                    showDbSetupModal();
                    return;
                }

                // Step 2: If permission is 'prompt', request it.
                // Chrome 86+ auto-grants without a prompt if previously granted.
                if (permission === 'prompt') {
                    try {
                        permission = await fileHandle.requestPermission(opts);
                    } catch (e) {
                        console.log('requestPermission could not auto-grant:', e);
                        // Fall through — will show modal below
                    }
                }

                // Step 3: If permission is granted, load the database
                if (permission === 'granted') {
                    try {
                        await loadDBFromFile();
                        closeDbSetup();
                        updateDbStatus(true);
                        initApp();
                        return; // Success — no modal needed
                    } catch (err) {
                        // File might have been deleted, moved, or corrupted
                        console.error('Error loading DB file on auto-connect:', err);
                        showToast('Database file could not be loaded. Please reconnect.', 'error');
                        fileHandle = null;
                        // Clear the invalid handle from IDB
                        clearFileHandleFromIDB();
                    }
                }

                // Step 4: Auto-connect failed — show the setup modal
                // This only happens if:
                //   - Permission was revoked by the browser
                //   - The file was deleted or corrupted
                //   - requestPermission could not auto-grant
                showDbSetupModal();
            } catch (e) {
                console.error('Auto-connect error:', e);
                showDbSetupModal();
            }
        }

        function showDbSetupModal() {
            const modal = document.getElementById('dbSetupModal');
            modal.classList.remove('hidden');
            modal.classList.add('modal-open');
        }

        function getFileHandleFromIDB() {
            return new Promise((resolve) => {
                try {
                    const request = indexedDB.open('crm_file_db', 1);
                    request.onupgradeneeded = e => {
                        const db = e.target.result;
                        if (!db.objectStoreNames.contains('handles')) db.createObjectStore('handles');
                    };
                    request.onsuccess = e => {
                        const db = e.target.result;
                        const tx = db.transaction('handles', 'readonly');
                        const store = tx.objectStore('handles');
                        store.get('fileHandle').onsuccess = (event) => {
                            resolve(event.target.result || null);
                        };
                        store.get('fileHandle').onerror = () => resolve(null);
                    };
                    request.onerror = () => resolve(null);
                } catch (e) {
                    console.error('IDB read error:', e);
                    resolve(null);
                }
            });
        }

        function clearFileHandleFromIDB() {
            try {
                const request = indexedDB.open('crm_file_db', 1);
                request.onupgradeneeded = e => {
                    const db = e.target.result;
                    if (!db.objectStoreNames.contains('handles')) db.createObjectStore('handles');
                };
                request.onsuccess = e => {
                    const db = e.target.result;
                    const tx = db.transaction('handles', 'readwrite');
                    tx.objectStore('handles').delete('fileHandle');
                };
            } catch (e) {
                console.error('IDB clear error:', e);
            }
        }

        // Start auto-connect on page load
        autoConnect();

        async function createDatabase() {
            try {
                fileHandle = await window.showSaveFilePicker({ suggestedName: 'crm-database.json', types: [{ description: 'JSON Database', accept: { 'application/json': ['.json'] } }] });
                await saveDB(); saveFileHandleToIDB(); closeDbSetup(); updateDbStatus(true); initApp(); showToast("New database created!");
            } catch (err) { if (err.name !== 'AbortError') console.error(err); }
        }

        async function linkDatabase() {
            try {
                [fileHandle] = await window.showOpenFilePicker({ types: [{ description: 'JSON Database', accept: { 'application/json': ['.json'] } }], multiple: false });
                await loadDBFromFile(); migrateDB(); await saveDB(); saveFileHandleToIDB(); closeDbSetup(); updateDbStatus(true); initApp(); showToast("Database linked successfully!");
            } catch (err) { if (err.name !== 'AbortError') console.error(err); }
        }

        function closeDbSetup() { document.getElementById('dbSetupModal').classList.add('hidden'); document.getElementById('dbSetupModal').classList.remove('modal-open'); }

        function saveFileHandleToIDB() {
            const request = indexedDB.open('crm_file_db', 1);
            request.onupgradeneeded = e => { const db = e.target.result; if (!db.objectStoreNames.contains('handles')) db.createObjectStore('handles'); };
            request.onsuccess = e => { const db = e.target.result; const tx = db.transaction('handles', 'readwrite'); tx.objectStore('handles').put(fileHandle, 'fileHandle'); };
        }

        async function loadDBFromFile() {
            const file = await fileHandle.getFile(); const text = await file.text();
            if (text) { DB = JSON.parse(text); migrateDB(); } else { DB = { clients: [], activities: [], activity_log: [], niches: [], settings: {}, dailyGoals: [] }; migrateDB(); }
        }

        async function saveDB() {
            if (fileHandle) {
                try {
                    const writable = await fileHandle.createWritable(); await writable.write(JSON.stringify(DB, null, 2)); await writable.close();
                } catch (err) { console.error("Save error:", err); showToast("Error saving to file", "error"); }
            } else { localStorage.setItem('crm_db', JSON.stringify(DB)); }
        }

        function updateDbStatus(isFile) {
            const dot = document.getElementById('db-status-dot'); const text = document.getElementById('db-status-text');
            if (!dot || !text) return; // Safety check if status elements don't exist
            if (isFile) { dot.className = 'w-2 h-2 bg-green-500 rounded-full'; text.innerText = 'Connected to Folder'; text.className = 'text-green-500 text-xs'; }
            else { dot.className = 'w-2 h-2 bg-slate-400 rounded-full'; text.innerText = 'Browser Storage Mode'; }
        }

        function logActivity(action, details) {
            DB.activity_log.unshift({ id: Date.now(), timestamp: new Date().toISOString(), action, details });
        }

        // ==========================================
        // 2. UTILS, THEME, & DYNAMIC SETTINGS
        // ==========================================
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container'); const toast = document.createElement('div');
            const colors = type === 'success' ? 'bg-green-600' : type === 'error' ? 'bg-red-600' : 'bg-primary';
            toast.className = `toast-in ${colors} text-white px-4 py-3 rounded-lg shadow-soft-lg text-sm font-medium flex items-center gap-2 min-w-[250px]`;
            toast.innerHTML = `<span>${message}</span>`; container.appendChild(toast);
            setTimeout(() => { toast.style.transition = 'opacity 0.3s, transform 0.3s'; toast.style.opacity = '0'; toast.style.transform = 'translateX(100%)'; setTimeout(() => toast.remove(), 300); }, 3000);
        }

        function toggleTheme() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                document.getElementById('theme-icon-sun').classList.add('hidden');
                document.getElementById('theme-icon-moon').classList.remove('hidden');
                DB.settings.theme = 'light';
            } else {
                document.documentElement.classList.add('dark');
                document.getElementById('theme-icon-sun').classList.remove('hidden');
                document.getElementById('theme-icon-moon').classList.add('hidden');
                DB.settings.theme = 'dark';
            }
            saveDB();
        }

        function applyThemeAndColors() {
            if (DB.settings.theme === 'light') {
                document.documentElement.classList.remove('dark');
                document.getElementById('theme-icon-sun').classList.add('hidden');
                document.getElementById('theme-icon-moon').classList.remove('hidden');
            } else {
                document.documentElement.classList.add('dark');
                document.getElementById('theme-icon-sun').classList.remove('hidden');
                document.getElementById('theme-icon-moon').classList.add('hidden');
            }
            // Apply Dynamic Colors
            const c = DB.settings.colors;
            const styleEl = document.getElementById('dynamic-colors');
            styleEl.innerHTML = `
                :root {
                    --color-primary: ${c.primary};
                    --color-primary-dark: ${shadeColor(c.primary, -10)};
                    --color-primary-light: ${shadeColor(c.primary, 20)};
                    --color-sidebar: ${c.sidebar};
                }
                .bg-primary { background-color: var(--color-primary); }
                .hover\:bg-primary-dark:hover { background-color: var(--color-primary-dark); }
                .text-primary { color: var(--color-primary); }
                .border-primary { border-color: var(--color-primary); }
                .ring-primary { --tw-ring-color: var(--color-primary); }
                .bg-sidebar-custom { background-color: var(--color-sidebar); }
            `;
        }

        function shadeColor(color, percent) {
            let R = parseInt(color.substring(1,3),16);
            let G = parseInt(color.substring(3,5),16);
            let B = parseInt(color.substring(5,7),16);
            R = parseInt(R * (100 + percent) / 100);
            G = parseInt(G * (100 + percent) / 100);
            B = parseInt(B * (100 + percent) / 100);
            R = (R<255)?R:255; G = (G<255)?G:255; B = (B<255)?B:255;
            R = Math.max(0,R); G = Math.max(0,G); B = Math.max(0,B);
            let rr = R.toString(16).padStart(2,'0');
            let gg = G.toString(16).padStart(2,'0');
            let bb = B.toString(16).padStart(2,'0');
            return `#${rr}${gg}${bb}`;
        }

        function getDaysPassed(dateString) { if (!dateString) return 0; const past = new Date(dateString); const now = new Date(); return Math.floor((now - past) / (1000 * 60 * 60 * 24)); }
        function copyToClipboard(text) { navigator.clipboard.writeText(text).then(() => showToast("Copied to clipboard!")); }

        // ==========================================
        // 3. DAILY GOAL LOGIC
        // ==========================================
        function getTodayGoalStatus() {
            const today = new Date().toDateString();
            const sentToday = DB.activities.filter(a => a.type === 'COLD_EMAIL' && new Date(a.date).toDateString() === today).length;
            const goal = DB.settings.dailyGoal || 20;
            const remaining = Math.max(0, goal - sentToday);
            const completed = sentToday >= goal;
            const bonus = completed ? sentToday - goal : 0;
            const percent = Math.min(100, Math.round((sentToday / goal) * 100));
            
            // Streak calculation
            let streak = 0;
            let bestStreak = 0;
            const sortedGoals = [...DB.dailyGoals].sort((a,b) => new Date(b.date) - new Date(a.date));
            
            // Check today first
            const todayLog = sortedGoals.find(g => new Date(g.date).toDateString() === today);
            if (completed && todayLog) streak = 1; // Start with today if completed

            // Calculate consecutive days backwards
            let checkDate = new Date();
            if (!completed) checkDate.setDate(checkDate.getDate() - 1); // Start from yesterday if today not done
            
            while(true) {
                const log = sortedGoals.find(g => new Date(g.date).toDateString() === checkDate.toDateString());
                if (log && log.completed) {
                    streak++;
                    checkDate.setDate(checkDate.getDate() - 1);
                } else {
                    break;
                }
            }
            
            bestStreak = DB.settings.bestStreak || 0;
            if (streak > bestStreak) {
                DB.settings.bestStreak = streak;
                bestStreak = streak;
            }

            return { sentToday, goal, remaining, completed, bonus, percent, streak, bestStreak };
        }

        function checkAndLogDailyGoal() {
            const status = getTodayGoalStatus();
            const today = new Date().toDateString();
            const logIndex = DB.dailyGoals.findIndex(g => new Date(g.date).toDateString() === today);
            
            if (status.completed) {
                if (logIndex === -1) {
                    DB.dailyGoals.push({ date: new Date().toISOString(), goal: status.goal, achieved: status.sentToday, completed: true });
                    logActivity('Daily Goal Achieved', `Reached ${status.sentToday}/${status.goal} emails today!`);
                } else if (!DB.dailyGoals[logIndex].completed) {
                    DB.dailyGoals[logIndex].completed = true;
                    DB.dailyGoals[logIndex].achieved = status.sentToday;
                    logActivity('Daily Goal Achieved', `Reached ${status.sentToday}/${status.goal} emails today!`);
                }
            }
        }

        function renderGoalTrackerWidget() {
            const status = getTodayGoalStatus();
            const widget = document.getElementById('goal-tracker-widget');
            let alertHtml = '';
            if (!status.completed) {
                alertHtml = `<div class="text-xs text-red-500 font-medium mt-2">🔴 ${status.remaining} remaining today</div>`;
            } else {
                alertHtml = `<div class="text-xs text-green-500 font-medium mt-2">🎉 Goal achieved! ${status.bonus > 0 ? `+${status.bonus} bonus` : ''}</div>`;
            }

            widget.innerHTML = `
                <div class="flex justify-between items-center mb-1">
                    <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">Today's Goal</span>
                    <span class="text-xs text-slate-500">${status.sentToday} / ${status.goal}</span>
                </div>
                <div class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
                    <div class="h-full bg-primary transition-all duration-500" style="width: ${status.percent}%"></div>
                </div>
                ${alertHtml}
                <div class="flex justify-between mt-2 text-[10px] text-slate-400">
                    <span>🔥 Streak: ${status.streak} days</span>
                    <span>🏆 Best: ${status.bestStreak} days</span>
                </div>
            `;
        }

        // ==========================================
        // 4. VIEW ROUTER & GLOBAL SEARCH
        // ==========================================
        function switchView(view, nicheName = null) {
            currentView = view;
            currentNicheView = nicheName;
            
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('bg-primary', 'text-white', 'shadow-soft');
                btn.classList.add('text-slate-600', 'dark:text-slate-400', 'hover:bg-slate-100', 'dark:hover:bg-slate-800', 'hover:text-slate-900', 'dark:hover:text-white');
            });
            const activeBtn = document.getElementById(`nav-${view}`);
            if (activeBtn) {
                activeBtn.classList.add('bg-primary', 'text-white', 'shadow-soft');
                activeBtn.classList.remove('text-slate-600', 'dark:text-slate-400', 'hover:bg-slate-100', 'dark:hover:bg-slate-800', 'hover:text-slate-900', 'dark:hover:text-white');
            }

            const addBtn = document.getElementById('add-client-btn');
            if (view === 'clients') { addBtn.classList.remove('hidden'); addBtn.classList.add('flex'); }
            else { addBtn.classList.add('hidden'); addBtn.classList.remove('flex'); }

            let title = view.replace(/([A-Z])/g, ' $1').trim().replace(/^\w/, c => c.toUpperCase());
            if (view === 'niche_page') title = `Niche: ${nicheName}`;
            document.getElementById('page-title').innerText = title;
            
            const container = document.getElementById('view-container');
            container.classList.remove('fade-in');
            void container.offsetWidth;
            container.classList.add('fade-in');
            
            renderApp();
        }

        function globalSearch(query) {
            const resultsContainer = document.getElementById('search-results');
            if (!query) { resultsContainer.classList.add('hidden'); return; }
            const q = query.toLowerCase();
            const results = DB.clients.filter(c => !c.is_deleted && (
                c.name?.toLowerCase().includes(q) || c.business_name?.toLowerCase().includes(q) || c.primary_email?.toLowerCase().includes(q) ||
                c.location?.toLowerCase().includes(q) || c.website?.toLowerCase().includes(q) || c.business_niche?.toLowerCase().includes(q) ||
                c.additional_emails?.some(e => e.toLowerCase().includes(q)) || c.notes?.some(n => n.text.toLowerCase().includes(q))
            )).slice(0, 10);

            if (results.length === 0) {
                resultsContainer.innerHTML = `<div class="p-4 text-sm text-slate-500">No results found</div>`;
            } else {
                resultsContainer.innerHTML = results.map(c => `
                    <div onclick="openClientModal(${c.id}); document.getElementById('search-results').classList.add('hidden'); document.getElementById('global-search').value='';" class="p-3 hover:bg-slate-50 dark:hover:bg-slate-700 cursor-pointer border-b border-slate-100 dark:border-slate-700 last:border-0">
                        <div class="font-medium text-sm text-slate-900 dark:text-white">${c.name}</div>
                        <div class="text-xs text-slate-500">${c.primary_email} - ${c.business_niche || 'No Niche'}</div>
                    </div>
                `).join('');
            }
            resultsContainer.classList.remove('hidden');
        }

        // ==========================================
        // 5. RENDERERS
        // ==========================================
        function renderApp() {
            processWorkflowAutomations();
            checkAndLogDailyGoal();
            renderGoalTrackerWidget();
            renderNicheSidebar();
            const container = document.getElementById('view-container');

            // Destroy existing charts to prevent memory leaks
            Object.values(chartInstances).forEach(chart => chart.destroy());
            chartInstances = {};

            if (currentView === 'dashboard') container.innerHTML = renderDashboard();
            else if (currentView === 'clients') container.innerHTML = renderTableView(DB.clients.filter(c => !c.is_deleted), 'clients');
            else if (currentView === 'sent') container.innerHTML = renderTableView(DB.clients.filter(c => !c.is_deleted && (c.status === 'SENT' || c.status === 'FOLLOWUP_SENT')), 'sent');
            else if (currentView === 'followups') container.innerHTML = renderTableView(DB.clients.filter(c => !c.is_deleted && c.status === 'SENT' && getDaysPassed(c.lastActivityDate) >= 7), 'followups');
            else if (currentView === 'responded') container.innerHTML = renderTableView(DB.clients.filter(c => !c.is_deleted && c.status === 'RESPONDED'), 'responded');
            else if (currentView === 'noresponse') container.innerHTML = renderTableView(DB.clients.filter(c => !c.is_deleted && c.status === 'NO_RESPONSE'), 'noresponse');
            else if (currentView === 'trash') container.innerHTML = renderTableView(DB.clients.filter(c => c.is_deleted), 'trash');
            else if (currentView === 'niches') container.innerHTML = renderNichesManagement();
            else if (currentView === 'niche_page') container.innerHTML = renderNichePage(currentNicheView);
            else if (currentView === 'activity') container.innerHTML = renderActivityLog();
            else if (currentView === 'settings') container.innerHTML = renderSettingsPage();
            else if (currentView === 'backup') container.innerHTML = renderBackupManager();
        }

        function renderNicheSidebar() {
            const activeNiches = DB.niches.filter(n => !n.is_deleted);
            document.getElementById('niche-list-sidebar').innerHTML = activeNiches.map(n => `
                <button onclick="switchView('niche_page', '${n.name}')" class="flex items-center gap-2 w-full px-3 py-1.5 text-xs text-slate-500 hover:text-primary transition-colors rounded-md hover:bg-slate-100 dark:hover:bg-slate-800 truncate">
                    <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> ${n.name}
                </button>
