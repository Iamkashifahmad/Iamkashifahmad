            const today = new Date().toDateString();
            const sentToday = DB.activities.filter(a => a.type === 'COLD_EMAIL' && new Date(a.date).toDateString() === today).length;
            const sentYesterday = DB.activities.filter(a => a.type === 'COLD_EMAIL' && getDaysPassed(a.date) === 1).length;
            const repliesToday = DB.activities.filter(a => a.type === 'RESPONSE' && new Date(a.date).toDateString() === today).length;
            const positiveReplies = DB.activities.filter(a => a.type === 'RESPONSE' && ['INTERESTED', 'MEETING_SCHEDULED', 'QUOTED', 'CLOSED'].includes(a.outcome)).length;
            const meetingsBooked = DB.activities.filter(a => a.type === 'RESPONSE' && a.outcome === 'MEETING_SCHEDULED').length;
            const totalSent = DB.activities.filter(a => a.type === 'COLD_EMAIL').length;
