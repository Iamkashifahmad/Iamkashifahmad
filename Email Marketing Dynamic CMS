                document.getElementById('name').value = client.name; document.getElementById('business_name').value = client.business_name || '';
                document.getElementById('primary_email').value = client.primary_email; document.getElementById('location').value = client.location || '';
                document.getElementById('website').value = client.website || ''; document.getElementById('business_niche').value = client.business_niche || '';
                document.getElementById('tags').value = client.tags?.join(', ') || '';
                if (client.additional_emails?.length > 0) client.additional_emails.forEach(email => addEmailField(email));
            } else { document.getElementById('modal-title').innerText = "Add New Client"; }
            openModal('clientModal');
        }

