                { title: 'Positive Replies', value: positiveReplies, trend: 'Total accumulated', color: 'text-green-500' },
                { title: 'Meetings Booked', value: meetingsBooked, trend: 'From responses', color: 'text-purple-500' },
                { title: 'Reply Rate', value: replyRate + '%', trend: 'Across all campaigns', color: 'text-indigo-500' },
                { title: 'Pending Follow-ups', value: DB.clients.filter(c => !c.is_deleted && c.status === 'SENT' && getDaysPassed(c.lastActivityDate) >= 7).length, trend: 'Needs action', color: 'text-yellow-500' },
                { title: 'No Response (90d)', value: DB.clients.filter(c => !c.is_deleted && c.status === 'NO_RESPONSE').length, trend: 'Aged out', color: 'text-red-500' },
                { title: 'Current Streak', value: goalStatus.streak + ' days', trend: `Best: ${goalStatus.bestStreak} days`, color: 'text-pink-500' },
                { title: 'Total Clients', value: DB.clients.filter(c => !c.is_deleted).length, trend: 'In pipeline', color: 'text-teal-500' },
                { title: 'Total Niches', value: DB.niches.filter(n => !n.is_deleted).length, trend: 'Active categories', color: 'text-cyan-500' }
